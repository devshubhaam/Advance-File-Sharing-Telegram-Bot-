# Copy these into Koyeb -> Service -> Environment variables
API_ID=
API_HASH=
BOT_TOKEN=
LOG_CHANNEL=-100XXXXXXXXXX
PORT=8000
# Optional (auto-detected on Koyeb if omitted)
# HOST=https://your-app-yourorg.koyeb.app
USE_SESSION_FILE=false
HASH_LENGTH=6
# ALLOWED_USERS=12345,67890
# USER_SESSION=
# MULTI_TOKEN1=
STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3
